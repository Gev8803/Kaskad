# ---------------------------------------------------------------------------
# Kaskad Group CMS — environment configuration
# Copy this file to `.env` and adjust values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Security -------------------------------------------------------------------
# Generate a new key for production, e.g.:
#   py -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-insecure-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to submit forms with CSRF (prod https origins)
CSRF_TRUSTED_ORIGINS=

# Admin bootstrap (used by `py manage.py create_admin`) ----------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kaskadgroup.am
ADMIN_PASSWORD=ChangeMe!2026

# CORS -----------------------------------------------------------------------
# In DEBUG all origins are allowed automatically. In production, list origins:
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=

# Media / storage ------------------------------------------------------------
MEDIA_URL=/media/
# MEDIA_ROOT=/absolute/path/to/media   # defaults to backend/media

# Database (SQLite by default; uncomment to use PostgreSQL, etc.) -------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kaskad
# DB_USER=kaskad
# DB_PASSWORD=secret
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Misc -----------------------------------------------------------------------
TIME_ZONE=Asia/Yerevan

# Production-only hardening (ignored when DEBUG=True) -------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
